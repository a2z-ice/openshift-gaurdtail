extends: default
rules:
  line-length: disable
  document-start: disable
  truthy: disable
  comments-indentation: disable
  comments:
    min-spaces-from-content: 1
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 1
  indentation:
    indent-sequences: consistent
